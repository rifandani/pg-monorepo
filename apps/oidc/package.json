{
  "name": "@workspace/oidc",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "OIDC Playground",
  "author": "Tri Rizeki Rifandani",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ngrok": "ngrok http --url=freely-equal-shepherd.ngrok-free.app 3333",
    "dev": "bun run --env-file=.env --hot src/app.ts",
    "node:dev": "dotenvx run --env-file=.env -- tsx watch src/app.ts",
    "node:build": "dotenvx run --env-file=.env -- tsc -p .",
    "node:start": "dotenvx run --env-file=.env -- node ./dist/node.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.49.0",
    "@t3-oss/env-core": "0.13.8",
    "@workspace/core": "workspace:*",
    "cors": "2.8.5",
    "desm": "1.3.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ky": "1.10.0",
    "oidc-provider": "9.5.1",
    "radashi": "12.6.2",
    "ts-pattern": "5.8.0",
    "type-fest": "5.0.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.4.0",
    "@types/oidc-provider": "9.5.0",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
